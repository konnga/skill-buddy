{
  "name": "@skillbuddy/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Skill parsing, unified format and per-agent adapters",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./planners": {
      "types": "./dist/planners.d.ts",
      "import": "./dist/planners.js"
    },
    "./semver": {
      "types": "./dist/semver.d.ts",
      "import": "./dist/semver.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
