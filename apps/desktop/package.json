{
  "name": "@skillbuddy/desktop",
  "version": "0.1.2",
  "productName": "SkillBuddy",
  "author": "SkillBuddy",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "description": "SkillBuddy desktop app (Electron + Vue 3)",
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.konnga.skillbuddy",
    "electronLanguages": ["en", "zh_CN"],
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsbuildinfo"
    ],
    "mac": {
      "icon": "resources/icons/icon.icns",
      "minimumSystemVersion": "11.0",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ]
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "icon": "resources/icons/icon.png",
      "executableName": "skillbuddy",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "category": "Development"
    },
    "extraResources": [
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/icons/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icons/icon-mac.png",
        "to": "icon-mac.png"
      },
      {
        "from": "resources/icons/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/tray",
        "to": "tray"
      }
    ]
  },
  "scripts": {
    "predev": "pnpm --filter @skillbuddy/core build",
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "test": "vitest run",
    "pretest:e2e": "pnpm --filter @skillbuddy/core build && pnpm build",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "start": "electron-vite preview",
    "dist:mac:arm64": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64",
    "dist:win:x64": "pnpm build && electron-builder --win nsis --x64",
    "dist:linux:x64": "pnpm build && electron-builder --linux AppImage --x64"
  },
  "dependencies": {
    "@skillbuddy/core": "workspace:*",
    "fflate": "^0.8.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lucide/vue": "^1.28.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "highlight.js": "^11.11.1",
    "@lobehub/icons-static-svg": "^1.94.0",
    "md-editor-v3": "^6.5.6",
    "@playwright/test": "^1.54.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "playwright": "^1.54.0",
    "reka-ui": "^2.10.1",
    "sass-embedded": "^1.100.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.8",
    "vue-tsc": "^2.1.10"
  }
}
