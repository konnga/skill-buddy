{
  "name": "skillbuddy",
  "version": "0.1.15",
  "private": true,
  "description": "SkillBuddy — visual management platform for AI agent skills (Claude Code, Codex, Cursor, OpenCode, Trae, CodeBuddy, WorkBuddy, and more)",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @skillbuddy/desktop dev",
    "build": "pnpm -r build",
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"**/*.{css,scss,vue}\"",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @skillbuddy/desktop test:e2e",
    "typecheck": "pnpm -r typecheck",
    "dist:mac:arm64": "pnpm --filter @skillbuddy/desktop dist:mac:arm64",
    "dist:mac:x64": "pnpm --filter @skillbuddy/desktop dist:mac:x64",
    "dist:win:x64": "pnpm --filter @skillbuddy/desktop dist:win:x64",
    "dist:win:arm64": "pnpm --filter @skillbuddy/desktop dist:win:arm64",
    "dist:linux:x64": "pnpm --filter @skillbuddy/desktop dist:linux:x64",
    "dist:linux:arm64": "pnpm --filter @skillbuddy/desktop dist:linux:arm64"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "globals": "catalog:",
    "lefthook": "catalog:",
    "postcss-html": "catalog:",
    "postcss-scss": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "typescript-eslint": "catalog:",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "vue-demi"
    ]
  }
}
