{
  "name": "skillbuddy",
  "version": "0.1.0",
  "private": true,
  "description": "SkillBuddy — visual management platform for AI agent skills (Claude Code, Codex, Cursor, OpenCode, Trae, CodeBuddy, WorkBuddy, ...)",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @skillbuddy/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "vue-demi"
    ]
  }
}
